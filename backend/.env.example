# ---- Server ----
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ---- PostgreSQL ----
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=school_sms
# Optionally, a single connection string instead of the PG* vars above:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/school_sms

# ---- Auth ----
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=8h
BCRYPT_SALT_ROUNDS=10

# ---- Uploads ----
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
